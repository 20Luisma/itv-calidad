# Configuración local de ITV Didáctica de Código (0 cuentas externas, 0 tokens)

# Puerto del dashboard web local
ITV_PORT=4173

# Pausa didáctica entre estaciones en milisegundos (modo cámara lenta)
ITV_SLOW_MO_MS=1800

# Umbral mínimo de cobertura de código (%) para la Estación 3
ITV_COVERAGE_MIN=75

# Ruta opcional de un repositorio local por defecto para inspeccionar
ITV_DEFAULT_TARGET_REPO=
