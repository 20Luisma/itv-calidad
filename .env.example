# Configuración opcional del servidor local
PORT=4173
HOST=127.0.0.1

# --- Integración opcional con SonarCloud / SonarQube (Estación 7) ---
# Si no definís SONAR_TOKEN, la ITV corre 100% local sin cuentas.
# SONAR_TOKEN=tu_token_personal_de_sonarcloud
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_PROJECT_KEY=opcional_si_el_repo_no_tiene_sonar-project.properties

# --- Integración opcional con Sentry (Estación 7) ---
# Token con permiso project:read + event:read en Sentry Settings > Auth Tokens
# SENTRY_AUTH_TOKEN=tu_auth_token_de_sentry
# SENTRY_ORG=tu-organizacion-sentry
# SENTRY_PROJECT=tu-proyecto-sentry
# SENTRY_BASE_URL=https://sentry.io
