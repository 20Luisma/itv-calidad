{
  "name": "itv-calidad",
  "version": "1.5.1",
  "description": "100% local, zero-account 7-station pre-push quality & security gate (MCP Server + MCP App + CLI + Web Dashboard) for PHP, Node.js/TypeScript, Python, and .NET/C#.",
  "type": "module",
  "license": "MIT",
  "author": "20Luisma",
  "homepage": "https://github.com/20Luisma/itv-calidad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/20Luisma/itv-calidad.git"
  },
  "bugs": {
    "url": "https://github.com/20Luisma/itv-calidad/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-app",
    "model-context-protocol",
    "pre-push",
    "code-quality",
    "devsecops",
    "security",
    "owasp",
    "wcag",
    "cursor",
    "claude-code",
    "local-sonar"
  ],
  "files": [
    "dist/application",
    "dist/domain",
    "dist/infrastructure",
    "dist/interfaces",
    "public",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bin": {
    "itv-calidad": "./dist/interfaces/cli/index.js",
    "itv-calidad-mcp": "./dist/interfaces/mcp/server.js",
    "itv-mcp": "./dist/interfaces/mcp/server.js",
    "itv-codigo": "./dist/interfaces/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/interfaces/web/server.ts",
    "start": "tsx src/interfaces/web/server.ts",
    "itv": "tsx src/interfaces/cli/index.ts",
    "mcp": "tsx src/interfaces/mcp/server.ts",
    "build": "tsc && node scripts/build-mcp-app.mjs",
    "build:vscode": "node scripts/build-vscode-extension.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=moderate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
