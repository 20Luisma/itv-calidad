{
  "name": "itv-calidad-vscode",
  "displayName": "ITV de Código",
  "description": "Gate DevSecOps local de 7 estaciones en tu barra lateral: sintaxis, tipos, cobertura, CVEs/OWASP, E2E, WCAG 2.1 AA y observabilidad (PHP, Node/TS, Python).",
  "version": "1.2.0",
  "publisher": "20luisma",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/20Luisma/itv-calidad.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "itv",
    "devsecops",
    "code-quality",
    "security",
    "owasp",
    "wcag",
    "pre-push",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:itvCockpitView",
    "onView:itvStationsView",
    "onCommand:itvCalidad.runInspection",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "itv-calidad-sidebar",
          "title": "ITV de Código",
          "icon": "media/itv-icon.svg"
        }
      ]
    },
    "views": {
      "itv-calidad-sidebar": [
        {
          "type": "webview",
          "id": "itvCockpitView",
          "name": "Cabina ITV"
        },
        {
          "id": "itvStationsView",
          "name": "7 Estaciones y Hallazgos"
        }
      ]
    },
    "commands": [
      {
        "command": "itvCalidad.runInspection",
        "title": "ITV: Pasar inspección (7 estaciones)",
        "icon": "$(play)"
      },
      {
        "command": "itvCalidad.stopInspection",
        "title": "ITV: Detener inspección",
        "icon": "$(debug-stop)"
      },
      {
        "command": "itvCalidad.exportMarkdown",
        "title": "ITV: Exportar evidencia (.md)",
        "icon": "$(markdown)"
      },
      {
        "command": "itvCalidad.openFinding",
        "title": "ITV: Abrir archivo en hallazgo"
      },
      {
        "command": "itvCalidad.configureIntegrations",
        "title": "ITV: Configurar integraciones (Sonar / Sentry / GitHub)",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "itvCalidad.runInspection",
          "when": "view == itvStationsView || view == itvCockpitView",
          "group": "navigation@1"
        },
        {
          "command": "itvCalidad.exportMarkdown",
          "when": "view == itvStationsView || view == itvCockpitView",
          "group": "navigation@2"
        }
      ]
    }
  }
}
