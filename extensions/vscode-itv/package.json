{
  "name": "itv-calidad-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.5.1",
  "publisher": "20luisma",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/20Luisma/itv-calidad.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "pre-push",
    "code-quality",
    "devsecops",
    "security",
    "owasp",
    "wcag",
    "mcp",
    "local-sonar",
    "cve-scanner",
    "secret-scanner",
    "ai-code-review",
    "itv"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:itvCockpitView",
    "onView:itvStationsView",
    "onCommand:itvCalidad.runInspection",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "itv-calidad-sidebar",
          "title": "%container.title%",
          "icon": "media/itv-icon.svg"
        }
      ]
    },
    "views": {
      "itv-calidad-sidebar": [
        {
          "type": "webview",
          "id": "itvCockpitView",
          "name": "%view.cockpit%"
        },
        {
          "id": "itvStationsView",
          "name": "%view.stations%"
        }
      ]
    },
    "commands": [
      {
        "command": "itvCalidad.runInspection",
        "title": "%cmd.run%",
        "icon": "$(play)"
      },
      {
        "command": "itvCalidad.stopInspection",
        "title": "%cmd.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "itvCalidad.exportMarkdown",
        "title": "%cmd.export%",
        "icon": "$(markdown)"
      },
      {
        "command": "itvCalidad.openFinding",
        "title": "%cmd.openFinding%"
      },
      {
        "command": "itvCalidad.configureIntegrations",
        "title": "%cmd.configureIntegrations%",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "itvCalidad.runInspection",
          "when": "view == itvStationsView || view == itvCockpitView",
          "group": "navigation@1"
        },
        {
          "command": "itvCalidad.exportMarkdown",
          "when": "view == itvStationsView || view == itvCockpitView",
          "group": "navigation@2"
        }
      ]
    }
  }
}
